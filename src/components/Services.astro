---
const services = [
  {
    title: "Reception sound",
    body: "Background music while guests mingle, transitioning into dance-friendly playlists. We tune the room (or the park!) so announcements are heard and and the music is crisp.",
  },
  {
    title: "Wireless mics for your MC",
    body: "Two handheld wireless mics for the MC, toasts, prayers, and announcements. We'll handle the audio so your people can focus on what they're saying.",
  },
  {
    title: "Ceremony amplification",
    body: "Lapel mic for the officiant, plus processional and recessional music. Especially valuable for outdoor ceremonies. We'll be flexible to your needs.",
  },
];
---

<section class="services section" id="what-we-do">
  <div class="container">
    <div class="services__intro">
      <p class="eyebrow">What we do</p>
      <h2>Polished, balanced, professional sound.</h2>
      <p class="muted">
        We know you want your wedding to go smoothly. We can help it sound great too.
        You won't have to worry if the MC can be heard or if the sound goes out at the wrong moment.
        We'll make sure that all your guests have a great audio experience!
      </p>
    </div>
    <ul class="services__grid">
      {services.map((s) => (
        <li class="services__item">
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .services {
    background: var(--color-cream);
  }

  .services__intro {
    margin-bottom: var(--space-12);
    max-width: 54rem;
  }

  .services__intro p:not(.eyebrow) {
    max-width: 38rem;
  }

  .services__grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .services__item {
    border-top: 1px solid color-mix(in srgb, var(--color-rust) 35%, transparent);
    padding-top: 1.25rem;
  }

  .services__item h3 {
    margin-bottom: 0.5rem;
  }

  .services__item p {
    margin: 0;
    color: var(--color-charcoal);
  }
</style>
