---
import { site } from "../data/site.ts";

const phoneHref = `tel:${site.phone.replace(/[^0-9+]/g, "")}`;
---

<section class="hero">
  <div class="container hero__inner">
    <div class="hero__text">
      <h1 class="hero__title">Reception sound done right.</h1>
      <p class="lede">
        Professional audio for indoor and outdoor events in Utah and Salt Lake counties.
      </p>
      <div class="hero__cta">
        <a class="btn btn--primary" href={phoneHref}>Call or text {site.phone}</a>
        <a class="btn btn--ghost" href="#packages">See packages</a>
      </div>
    </div>
    <div class="hero__mark">
      <img
        class="hero__avocet"
        src="/illustrations/avocet-sillhouette.svg"
        alt="Avocet silhouette, illustration by Sarah"
        width="407"
        height="495"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3.5rem, 9vw, 6.5rem) clamp(3rem, 8vw, 5.5rem);
    background:
      radial-gradient(
        circle at 85% 15%,
        color-mix(in srgb, var(--color-rust-soft) 22%, transparent),
        transparent 55%
      ),
      var(--color-cream);
    overflow: hidden;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(1.5rem, 5vw, 4rem);
  }

  .hero__text h1 {
    margin-block: var(--space-2) var(--space-6);
  }

  .hero__title {
    font-size: clamp(2.25rem, 4vw + 1rem, 3.75rem);
    text-wrap: balance;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: var(--space-6);
  }

  .hero__mark {
    width: clamp(9rem, 22vw, 16rem);
  }

  .hero__avocet {
    width: 100%;
    height: auto;
    transform: scaleX(-1);
  }

  @media (max-width: 720px) {
    .hero__inner {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }
    .hero__text {
      max-width: 32rem;
    }
    .hero__text .lede {
      margin-inline: auto;
    }
    .hero__cta {
      justify-content: center;
    }
    .hero__mark {
      order: -1;
      width: 9rem;
      margin-bottom: 1rem;
      margin-inline: auto;
    }
  }
</style>
