---
import { site } from "../data/site.ts";
import Divider from "./Divider.astro";
import ContactCard from "./ContactCard.astro";

const phoneHref = `tel:${site.phone.replace(/[^0-9+]/g, "")}`;
const smsHref = `sms:${site.phone.replace(/[^0-9+]/g, "")}`;
const emailHref = `mailto:${site.email}`;
---

<section class="contact-strip section" id="contact">
  <div class="container contact-strip__inner">
    <Divider />
    <h2 class="contact-strip__heading">Let's talk about your event.</h2>
    <p class="contact-strip__lede muted">
      Call, text, or email — usually a quick conversation gets us most of the way to a quote.
    </p>
    <div class="contact-strip__methods">
      <ContactCard label="Call" value={site.phone} href={phoneHref} />
      <ContactCard label="Text" value={site.phone} href={smsHref} />
      <ContactCard label="Email" value={site.email} href={emailHref} />
    </div>
    <p class="contact-strip__more">
      <a href="/contact">More about working with us →</a>
    </p>
  </div>
</section>

<style>
  .contact-strip {
    background: var(--color-cream);
    text-align: center;
  }

  .contact-strip__inner {
    max-width: 48rem;
  }

  .contact-strip__heading {
    margin-top: var(--space-8);
  }

  .contact-strip__lede {
    margin-inline: auto;
    margin-bottom: var(--space-8);
  }

  .contact-strip__methods {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 0.75rem;
    margin: 0 auto var(--space-6);
  }

  .contact-strip__more {
    font-size: 0.95rem;
  }
</style>
