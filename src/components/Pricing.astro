---
import { baseRate, addOns, promotion, promotionActive } from "../data/packages.ts";
---

<section class="pricing section" id="pricing">
  <div class="container">
    <div class="pricing__intro">
      <p class="eyebrow">Pricing</p>
      <h2>Straightforward and affordable.</h2>
      <p class="muted">
        Everything starts from a flat hourly rate. Set
        up and take-down are always free, not part of the time.
      </p>
    </div>
    {promotionActive && (
      <aside class="pricing__promo" role="note" aria-label="Limited-time offer">
        <p class="pricing__promo-eyebrow">
          {promotion.headline} · {promotion.percentOff}% off through {promotion.deadlineLabel}
        </p>
        <p class="pricing__promo-body">{promotion.body}</p>
      </aside>
    )}
    <div class="pricing__sheet">
      <div class="rate rate--foundation">
        <div class="rate__head">
          <h3 class="rate__label">{baseRate.label}</h3>
          <p class="rate__amount">
            {baseRate.regularAmount && (
              <span class="rate__was">{baseRate.regularAmount}</span>
            )}
            {baseRate.amount}
          </p>
        </div>
        <p class="rate__note">{baseRate.note}</p>
      </div>

      <p class="pricing__addons-label">Add as your event needs</p>

      {addOns.map((item) => (
        <div class="rate">
          <div class="rate__head">
            <h3 class="rate__label">{item.label}</h3>
            <p class="rate__amount">{item.amount}</p>
          </div>
          <p class="rate__note">{item.note}</p>
        </div>
      ))}
    </div>
    <p class="pricing__footnote">
      Travel beyond our service area or exceptional needs quoted separately.
    </p>
  </div>
</section>

<style>
  .pricing {
    background: var(--color-cream-warm);
  }

  .pricing__intro {
    margin-bottom: var(--space-8);
    max-width: 54rem;
  }

  .pricing__intro p:not(.eyebrow) {
    max-width: 42rem;
  }

  .pricing__promo {
    margin-bottom: var(--space-8);
    padding: 1rem 1.25rem;
    background: color-mix(in srgb, var(--color-rust-soft) 22%, var(--color-cream));
    border-left: 3px solid var(--color-rust);
    max-width: 44rem;
  }

  .pricing__promo-eyebrow {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-rust-deep);
    margin: 0 0 0.5rem;
  }

  .pricing__promo-body {
    margin: 0;
    color: var(--color-charcoal);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .pricing__sheet {
    max-width: 42rem;
  }

  .rate {
    border-top: 1px solid color-mix(in srgb, var(--color-slate-soft) 50%, transparent);
    padding-block: 1.25rem;
  }

  .rate--foundation {
    border-top: 2px solid var(--color-rust);
    padding-top: 1.25rem;
  }

  .rate__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .rate__label {
    font-size: 1.2rem;
    margin: 0;
  }

  .rate__amount {
    margin: 0;
    flex-shrink: 0;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--color-rust);
    white-space: nowrap;
  }

  .rate--foundation .rate__amount {
    font-size: 1.75rem;
  }

  .rate__was {
    font-size: 1.1rem;
    color: var(--color-slate);
    text-decoration: line-through;
    text-decoration-color: color-mix(in srgb, var(--color-slate) 60%, transparent);
    margin-right: 0.4rem;
  }

  .rate__note {
    margin: 0.5rem 0 0;
    color: var(--color-charcoal);
    font-size: 0.95rem;
    line-height: 1.55;
    max-width: 34rem;
  }

  .pricing__addons-label {
    margin: var(--space-8) 0 0;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-slate);
  }

  .pricing__footnote {
    margin-top: 1.5rem;
    color: var(--color-slate);
    font-size: 0.9rem;
  }
</style>
