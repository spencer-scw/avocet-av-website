---
import Base from "../layouts/Base.astro";
import ContactCard from "../components/ContactCard.astro";
import { site } from "../data/site.ts";

const phoneHref = `tel:${site.phone.replace(/[^0-9+]/g, "")}`;
const smsHref = `sms:${site.phone.replace(/[^0-9+]/g, "")}`;
const emailHref = `mailto:${site.email}`;

const logistics = [
  {
    label: "Lead time",
    body: "Most clients book 2–6 months out. Shorter timelines welcome when our calendar allows — use the availability checker on the home page for a quick yes/no.",
  },
  {
    label: "Travel",
    body: `Base rates cover ${site.serviceArea}. We're available beyond that for an additional travel fee — just ask.`,
  },
  {
    label: "What we'll ask",
    body: "Event date and time, venue, approximate guest count, ceremony vs. reception coverage, and any timeline anchors (toasts, dances, etc.).",
  },
];
---

<Base title="Contact" description="Get in touch with Avocet AV about your wedding or event.">
  <section class="contact-hero section">
    <div class="container contact-hero__inner">
      <img
        class="contact-hero__mark"
        src="/illustrations/avocet-jammin-2.svg"
        alt="Avocet with headphones, illustration by Sarah"
        width="414"
        height="504"
      />
      <p class="eyebrow">Contact</p>
      <h1>Let's talk.</h1>
      <p class="lede">
        A quick call or text is the fastest way to check availability and get a
        quote. We typically respond the same day.
      </p>
    </div>
  </section>

  <section class="contact-methods section--tight">
    <div class="container contact-methods__inner">
      <ContactCard label="Call" value={site.phone} href={phoneHref} />
      <ContactCard label="Text" value={site.phone} href={smsHref} />
      <ContactCard label="Email" value={site.email} href={emailHref} />
    </div>
  </section>

  <section class="contact-info section">
    <div class="container contact-info__inner">
      <div class="contact-info__service-area">
        <p class="eyebrow">Service area</p>
        <h2>{site.serviceArea}</h2>
        <p class="muted">
          We're based locally and cover events throughout Utah and Salt Lake counties as part of our base pricing. Travel beyond that is available for an additional fee.
        </p>
      </div>
      <dl class="contact-info__logistics">
        {logistics.map((item) => (
          <div class="contact-info__row">
            <dt>{item.label}</dt>
            <dd>{item.body}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</Base>

<style>
  .contact-hero {
    text-align: center;
    background: var(--color-cream);
    padding-block: clamp(3rem, 8vw, 5rem) clamp(2rem, 5vw, 3rem);
  }

  .contact-hero__inner {
    max-width: 36rem;
  }

  .contact-hero__mark {
    width: 18rem;
    height: auto;
    margin: 0 auto var(--space-6);
  }

  .contact-hero h1 {
    margin-bottom: var(--space-4);
  }

  .contact-hero .lede {
    margin-inline: auto;
  }

  .contact-methods__inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 0.75rem;
  }

  .contact-info {
    background: var(--color-cream);
  }

  .contact-info__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: clamp(2rem, 5vw, 4rem);
  }

  @media (max-width: 720px) {
    .contact-info__inner {
      grid-template-columns: 1fr;
    }
  }

  .contact-info__service-area h2 {
    margin-bottom: var(--space-3);
  }

  .contact-info__logistics {
    margin: 0;
    display: grid;
    gap: 1.25rem;
  }

  .contact-info__row {
    border-top: 1px solid color-mix(in srgb, var(--color-rust) 30%, transparent);
    padding-top: 0.875rem;
  }

  .contact-info__row dt {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-ink);
    margin-bottom: 0.25rem;
  }

  .contact-info__row dd {
    margin: 0;
    color: var(--color-charcoal);
  }
</style>
