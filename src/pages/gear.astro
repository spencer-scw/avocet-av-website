---
import Base from "../layouts/Base.astro";
---

<Base
  title="Gear"
  description="The audio equipment Avocet AV brings to receptions and ceremonies."
>
  <section class="gear section">
    <div class="container gear__inner">
      <p class="eyebrow">Gear</p>
      <h1>What we bring.</h1>
      <p class="lede">
        A rundown of the equipment we use for receptions and ceremonies.
      </p>
      <p class="muted gear__placeholder">
        Coming soon — we're putting together photos and specs of our current rig.
        In the meantime, if you have a specific question about our setup,
        <a href="/#contact">reach out</a> and we'll fill you in.
      </p>
      <p class="gear__back">
        <a href="/">← Back to home</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .gear {
    background: var(--color-cream);
  }

  .gear__inner {
    max-width: 38rem;
  }

  .gear__inner h1 {
    margin-block: var(--space-3) var(--space-6);
  }

  .gear__placeholder {
    margin-bottom: var(--space-8);
  }

  .gear__back {
    font-size: 0.95rem;
  }
</style>
